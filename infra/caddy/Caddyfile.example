# SchoolBell Caddyfile (installed to /etc/schoolbell/Caddyfile by install.sh)
# Replace HOSTNAME with the address classrooms will use (DNS name recommended,
# IP acceptable). `tls internal` uses Caddy's local CA; its root certificate is
# at /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt and must
# be distributed to Windows clients (--ca-file at install). For a school CA,
# replace `tls internal` with: tls /etc/schoolbell/server.crt /etc/schoolbell/server.key
{
	ca_server_local_trusted
	auto_https off
}

https://HOSTNAME:443 {
	tls internal
	encode gzip
	# WebSocket control + media paths are proxied transparently by reverse_proxy
	reverse_proxy 127.0.0.1:5001
}
