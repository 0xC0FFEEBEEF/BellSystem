[Unit]
Description=SchoolBell HTTPS reverse proxy (Caddy)
After=network-online.target schoolbell.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/caddy run --config /etc/schoolbell/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/schoolbell/Caddyfile
Restart=always
RestartSec=3
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=root

[Install]
WantedBy=multi-user.target
