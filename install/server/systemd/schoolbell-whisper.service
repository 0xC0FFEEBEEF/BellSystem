[Unit]
Description=SchoolBell local Whisper transcription engine
Documentation=file:///opt/schoolbell/current/OPERATIONS.md
After=local-fs.target
Before=schoolbell.service

[Service]
User=schoolbell
Group=schoolbell
WorkingDirectory=/opt/schoolbell/current/whisper
Environment=LD_LIBRARY_PATH=/opt/schoolbell/current/whisper/bin
ExecStart=/opt/schoolbell/current/whisper/bin/whisper-server --host 127.0.0.1 --port 8178 --threads 4 --processors 1 --model /opt/schoolbell/current/whisper/models/ggml-small.en.bin --no-gpu --no-timestamps
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=200%
MemoryMax=2G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
