[Unit]
Description=SchoolBell server (bells and announcements)
Documentation=file:///opt/schoolbell/current/OPERATIONS.md
After=network-online.target schoolbell-whisper.service
Wants=network-online.target schoolbell-whisper.service

[Service]
User=schoolbell
Group=schoolbell
WorkingDirectory=/opt/schoolbell/current/app
ExecStart=/opt/schoolbell/current/app/SchoolBell.Server
EnvironmentFile=/etc/schoolbell/env
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=3
# many endpoints = many long-lived WebSockets
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/schoolbell
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
