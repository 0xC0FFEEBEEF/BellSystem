[Unit]
Description=SchoolBell HTTPS front end (Caddy)
After=network-online.target schoolbell.service
Wants=network-online.target

[Service]
User=schoolbell-proxy
Group=schoolbell-proxy
ExecStart=/opt/schoolbell/bin/caddy run --config /etc/schoolbell/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/schoolbell-proxy
Environment=HOME=/var/lib/schoolbell-proxy XDG_DATA_HOME=/var/lib/schoolbell-proxy XDG_CONFIG_HOME=/var/lib/schoolbell-proxy

[Install]
WantedBy=multi-user.target
