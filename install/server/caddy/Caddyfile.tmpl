# Generated by install.sh — re-run install.sh to change hostnames or TLS (manual edits are replaced).
{
	admin off
	storage file_system @PROXYVAR@
	skip_install_trust
	auto_https disable_redirects
}

@SITES@ {
	@TLS@
	encode zstd gzip
	# office UI, API and both WebSocket channels share this one HTTPS origin
	reverse_proxy 127.0.0.1:5001 {
		header_up X-Forwarded-Host {hostport}
		flush_interval -1
	}
}
