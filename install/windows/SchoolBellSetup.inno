; SchoolBellSetup.inno — Inno Setup 6 script for the Windows client.
; Build on the lab: "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" install\windows\SchoolBellSetup.inno
; Silent deployment (plan §2):
;   SchoolBellSetup.exe /silent /SERVER=https://10.0.2.9 /ENROLLMENTFILE=C:\tmp\token.txt
;     [/CAFILE=C:\tmp\ca-root.crt] [/NOCHECK]
; Upgrade: run again (in-place). Repair: Apps & Features > Change > Repair.
; Uninstall: removes service, logon task, files, and the device credential under
; ProgramData\SchoolBell (server-side records stay; re-enroll needs a new token).
#define MyAppName "SchoolBell"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "SchoolBell pilot"

[Setup]
AppId=7E1B4C1C-6C7A-4C1A-9F4E-01D2C3B4A5F6
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\SchoolBell
DisableProgramGroupPage=yes
DisableWelcomePage=no
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\..\dist
OutputBaseFilename=SchoolBellSetup
UninstallDisplayIcon={app}\SchoolBellCompanion.exe
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\..\dist\publish\client-service\*";    DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\..\dist\publish\client-companion\*";  DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\..\dist\publish\enroll-tool\*";       DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Dirs]
Name: "{commonappdata}\SchoolBell"; Permissions: users-modify

[Run]
; (enrollment + service + task all happen in [Code] so failures can abort the install)

[UninstallRun]
Filename: "sc.exe"; Parameters: "stop SchoolBellService"; RunOnceId: "StopSvc"; StatusMsg: "Stopping SchoolBell service..."
Filename: "sc.exe"; Parameters: "delete SchoolBellService"; RunOnceId: "DelSvc"; StatusMsg: "Removing SchoolBell service..."
Filename: "schtasks.exe"; Parameters: "/delete /tn ""SchoolBellCompanion"" /f"; RunOnceId: "DelTask"; StatusMsg: "Removing logon task..."

[Code]
var
  ServerUrl: String;
  EnrollmentFile: String;
  CaFile: String;

function GetSwitchValue(const Name: String): String;
var
  I: Integer;
begin
  Result := '';
  I := 1;
  while I <= ParamCount do
  begin
    if Pos('/' + Name + '=', UpperCase(ParamStr(I))) > 0 then
    begin
      Result := Copy(ParamStr(I), Pos('=', ParamStr(I)) + 1, Length(ParamStr(I)));
      Break;
    end;
    I := I + 1;
  end;
end;

function TryHttps(String Url): String;
begin
  Result := Url;
  if Pos('://', Result) = 0 then Result := 'https://' + Result;
end;

function InitializeSetup(): Boolean;
begin
  ServerUrl := GetSwitchValue('SERVER');
  EnrollmentFile := GetSwitchValue('ENROLLMENTFILE');
  CaFile := GetSwitchValue('CAFILE');
  Result := True;
  if ServerUrl = '' then
  begin
    if not InputQuery('SchoolBell setup', 'School server address (https://host):', ServerUrl) then
    begin
      Result := False;
      Exit;
    end;
  end;
  ServerUrl := TryHttps(ServerUrl);
  if (EnrollmentFile <> '') and (not FileExists(EnrollmentFile)) then
  begin
    MsgBox('Enrollment file not found: ' + EnrollmentFile, mbCriticalError, 0);
    Result := False;
  end;
  if (CaFile <> '') and (not FileExists(CaFile)) then
  begin
    MsgBox('CA file not found: ' + CaFile, mbCriticalError, 0);
    Result := False;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
  ConfigPath: String;
begin
  if CurStep <> ssPostInstall then Exit;
  ConfigPath := ExpandConstant('{commonappdata}\SchoolBell\config.json');

  { 1. private school CA into the machine trust store (no validation bypass anywhere) }
  if CaFile <> '' then
  begin
    Exec('certutil.exe', '-add-store "LocalMachine\Root" "' + CaFile + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    if ResultCode <> 0 then
      MsgBox('Warning: could not install the school CA certificate (certutil exit ' + IntToStr(ResultCode) + '). ' +
             'Browsers/services will not trust the server TLS certificate.', mbError, MB_OK);
  end;

  { 2. enrollment — skipped when this machine already has credentials (upgrade/repair) }
  if not FileExists(ConfigPath) then
  begin
    if EnrollmentFile = '' then
      EnrollmentFile := WizardDirValue + '\enrollment.json';
    Exec(ExpandConstant('{app}\EnrollTool.exe'),
      '--server "' + ServerUrl + '" --token-file "' + EnrollmentFile + '" --device-name ' + ComputerName +
      ' --out "' + ConfigPath + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    if ResultCode <> 0 then
    begin
      MsgBox('Enrollment failed (exit ' + IntToStr(ResultCode) + '). ' +
             'A valid enrollment token file (--enrollment-file, or enrollment.json next to the installer) ' +
             'is required before the service can be installed.', mbCriticalError, MB_OK);
      Abort;
    end;
  end;

  { 3. service (session 0: connection, cache, ledger, keep-awake, named pipe) }
  Exec('sc.exe', 'create SchoolBellService binPath= "' + ExpandConstant('{app}\SchoolBellService.exe') + '" start= auto DisplayName= "SchoolBell"',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  if ResultCode <> 0 and ResultCode <> 1072 then { 1072 = already exists (repair/upgrade) }
  begin
    MsgBox('Could not create the SchoolBell service (sc exit ' + IntToStr(ResultCode) + ').', mbCriticalError, MB_OK);
    Abort;
  end;
  Exec('sc.exe', 'start SchoolBellService', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

  { 4. tray companion at every user logon }
  Exec('schtasks.exe', '/create /tn "SchoolBellCompanion" /tr "' + ExpandConstant('{app}\SchoolBellCompanion.exe') + '" /sc ONLOGON /ru "" /f',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  if ResultCode <> 0 then
    MsgBox('Warning: the logon task for the tray companion was not created (schtasks exit ' + IntToStr(ResultCode) + '). ' +
           'Start SchoolBellCompanion manually or re-run the installer in Repair mode.', mbError, MB_OK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    if DirExists(ExpandConstant('{commonappdata}\SchoolBell')) then
      DelTree(ExpandConstant('{commonappdata}\SchoolBell'), True, True, True);
end;
